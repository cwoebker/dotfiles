# zsh completions: brew-installed completions on fpath, then init.
# compinit MUST run before sheldon sources oh-my-zsh plugins so that
# `compdef` is defined when those plugins try to register completions.
fpath=(/opt/homebrew/share/zsh-completions $fpath)
autoload -Uz compinit && compinit

# sheldon — plugin manager (oh-my-zsh git/macos)
command -v sheldon > /dev/null && eval "$(sheldon source)"

# mise — version manager auto-switching for interactive shells
command -v mise > /dev/null && eval "$(mise activate zsh)"

# zoxide — smarter cd (replaces z). Provides `z` and `zi`.
command -v zoxide > /dev/null && eval "$(zoxide init zsh)"

# fzf shell integration (key bindings + completion)
FZF_SHELL="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/fzf/shell"
[[ -f $FZF_SHELL/key-bindings.zsh ]] && source $FZF_SHELL/key-bindings.zsh
[[ -f $FZF_SHELL/completion.zsh ]] && source $FZF_SHELL/completion.zsh

# Track kubectl invocations so the prompt's kctx segment can show
# during the hour after a kubectl command, even outside a k8s repo.
autoload -Uz add-zsh-hook
_track_kubectl() {
  [[ "$1" == kubectl* ]] && touch "$HOME/.cache/last-kubectl" 2>/dev/null
}
mkdir -p "$HOME/.cache" 2>/dev/null
add-zsh-hook preexec _track_kubectl

# Starship prompt — replaces oh-my-zsh themes
command -v starship > /dev/null && eval "$(starship init zsh)"

# Custom config and shell functions
source $DOTFILES/shell/config.zsh
source $DOTFILES/shell/functions.zsh

# Source all aliases.zsh files in the repo
typeset -U alias_files
alias_files=($DOTFILES/**/aliases.zsh)
for file in ${alias_files}; do
  source $file
done
unset alias_files

# zsh-autosuggestions and zsh-syntax-highlighting must be sourced LAST
# so they wrap all previously-defined widgets correctly.
ZSH_BREW_SHARE="${HOMEBREW_PREFIX:-/opt/homebrew}/share"
[[ -f $ZSH_BREW_SHARE/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
    source $ZSH_BREW_SHARE/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f $ZSH_BREW_SHARE/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
    source $ZSH_BREW_SHARE/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# atuin — SQLite-backed shell history with fuzzy search.
# Binds Ctrl-R to atuin search; --disable-up-arrow keeps ↑ as plain
# previous-command (atuin's up-arrow override surprises muscle memory).
command -v atuin > /dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# ~/.zshlocalrc for machine-local and work-related settings (never tracked)
[[ -a ~/.zshlocalrc ]] && source ~/.zshlocalrc
